{
  "openapi": "3.1.0",
  "info": {
    "title": "x402-grocery",
    "version": "0.1.0",
    "description": "Real grocery product search and cart building over the Kroger API, priced per operation\n\nEvery paid route returns the purchased artifact in the 200 response body. Pay in USDC on Base or Solana — your client picks the rail.",
    "license": {
      "name": "Apache-2.0",
      "identifier": "Apache-2.0"
    },
    "contact": {
      "name": "nirholas",
      "email": "nichxbt@gmail.com",
      "url": "https://github.com/nirholas/x402-grocery"
    },
    "x-guidance": "Real grocery product search and cart building over the Kroger API, priced per operation. Every paid route answers an unpaid request with HTTP 402 and a list of accepted payments (USDC on Base or Solana — pick either), then returns the purchased artifact in the body of the same request once you retry with an X-PAYMENT header. Payment and delivery happen in one round trip; nothing is promised for later. GET /products ($0.002) returns real products with prices + aisle POST /cart ($0.005) returns built cart with line prices, totals, substitutions"
  },
  "servers": [
    {
      "url": "http://localhost:4021",
      "description": "Local development"
    },
    {
      "url": "https://your-deployment.example.com",
      "description": "Your deployment"
    }
  ],
  "tags": [
    {
      "name": "paid",
      "description": "x402-paid routes. An unpaid request answers 402 with both rails."
    },
    {
      "name": "free",
      "description": "Free routes. No payment required."
    }
  ],
  "paths": {
    "/products": {
      "get": {
        "operationId": "searchProducts",
        "summary": "Search grocery products with prices, promos, aisle locations and stock levels.",
        "description": "Full-text search across the grocery catalog. Returns each product's identifiers, brand, package size, regular and promotional price, the aisle it sits in, and its current stock level. Pass a `locationId` to price against a specific store.\n\nPrice: **$0.002** in USDC — payable on Base (EVM) or Solana.",
        "tags": [
          "paid"
        ],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Search term, e.g. `whole milk`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Maximum products to return (1–50).",
            "schema": {
              "type": "integer",
              "default": 10
            }
          },
          {
            "name": "locationId",
            "in": "query",
            "required": false,
            "description": "Kroger store id to price against. Omit for the default location.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "matching products with regular and promo prices, size, aisle, and stock level",
            "headers": {
              "X-PAYMENT-RESPONSE": {
                "description": "Base64 JSON settlement receipt (rail, network, transaction, payer).",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "source": {
                      "type": "string"
                    },
                    "query": {
                      "type": "string"
                    },
                    "locationId": {
                      "type": "string"
                    },
                    "count": {
                      "type": "integer"
                    },
                    "products": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "productId": {
                            "type": "string"
                          },
                          "upc": {
                            "type": "string"
                          },
                          "description": {
                            "type": "string"
                          },
                          "brand": {
                            "type": "string"
                          },
                          "category": {
                            "type": "string"
                          },
                          "size": {
                            "type": "string"
                          },
                          "price": {
                            "type": "object",
                            "properties": {
                              "regular": {
                                "type": "number"
                              },
                              "promo": {
                                "type": "number"
                              }
                            }
                          },
                          "aisle": {
                            "type": "string"
                          },
                          "stockLevel": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "payment": {
                      "type": "object",
                      "properties": {
                        "success": {
                          "type": "boolean"
                        },
                        "rail": {
                          "type": "string"
                        },
                        "network": {
                          "type": "string"
                        },
                        "transaction": {
                          "type": "string"
                        },
                        "payer": {
                          "type": "string"
                        },
                        "amount": {
                          "type": "string"
                        },
                        "asset": {
                          "type": "string"
                        },
                        "resource": {
                          "type": "string"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "source": "fixture",
                  "query": "whole milk",
                  "locationId": "01400376",
                  "count": 2,
                  "products": [
                    {
                      "productId": "0001111041700",
                      "upc": "0001111041700",
                      "description": "Kroger Vitamin D Whole Milk",
                      "brand": "Kroger",
                      "category": "Dairy",
                      "size": "1 gal",
                      "price": {
                        "regular": 3.79,
                        "promo": 3.29
                      },
                      "aisle": "Dairy",
                      "stockLevel": "HIGH"
                    },
                    {
                      "productId": "0007084300001",
                      "upc": "0007084300001",
                      "description": "Horizon Organic Whole Milk",
                      "brand": "Horizon Organic",
                      "category": "Dairy",
                      "size": "64 fl oz",
                      "price": {
                        "regular": 5.49,
                        "promo": null
                      },
                      "aisle": "Dairy",
                      "stockLevel": "HIGH"
                    }
                  ],
                  "payment": {
                    "success": true,
                    "rail": "evm",
                    "network": "base-sepolia",
                    "transaction": "0x9c1f…",
                    "payer": "0xA11ce…",
                    "amount": "2000",
                    "asset": "0x036CbD53842c5426634e7929541eC2318f3dCF7e",
                    "resource": "http://localhost:4021/products"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "402": {
            "$ref": "#/components/responses/PaymentRequired"
          },
          "502": {
            "$ref": "#/components/responses/UpstreamError"
          }
        },
        "x-payment-info": {
          "price": {
            "mode": "fixed",
            "currency": "USD",
            "amount": "0.002000"
          },
          "protocols": [
            {
              "x402": {}
            }
          ]
        }
      }
    },
    "/cart": {
      "post": {
        "operationId": "buildCart",
        "summary": "Build a fully priced cart from a shopping list, substituting out-of-stock items.",
        "description": "Takes a shopping list of free-text queries and/or UPCs with quantities. Each line is matched against the catalog; a UPC that doesn't resolve or a product that's temporarily out of stock is substituted with the closest in-stock match and the substitution is recorded on the line. Returns every line plus a summary with subtotal, estimated tax, and estimated total. One price regardless of line count.\n\nPrice: **$0.005** in USDC — payable on Base (EVM) or Solana.",
        "tags": [
          "paid"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "query": {
                          "type": "string"
                        },
                        "quantity": {
                          "type": "integer"
                        }
                      }
                    }
                  },
                  "locationId": {
                    "type": "string"
                  }
                }
              },
              "example": {
                "items": [
                  {
                    "query": "whole milk",
                    "quantity": 1
                  },
                  {
                    "query": "eggs",
                    "quantity": 2
                  }
                ],
                "locationId": "01400376"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "a priced cart: matched line items, substitutions, line totals, subtotal, tax, and grand total",
            "headers": {
              "X-PAYMENT-RESPONSE": {
                "description": "Base64 JSON settlement receipt (rail, network, transaction, payer).",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "source": {
                      "type": "string"
                    },
                    "cartId": {
                      "type": "string"
                    },
                    "locationId": {
                      "type": "string"
                    },
                    "builtAt": {
                      "type": "string"
                    },
                    "lines": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "requested": {
                            "type": "object",
                            "properties": {
                              "query": {
                                "type": "string"
                              },
                              "quantity": {
                                "type": "integer"
                              }
                            }
                          },
                          "matched": {
                            "type": "object",
                            "properties": {
                              "productId": {
                                "type": "string"
                              },
                              "upc": {
                                "type": "string"
                              },
                              "description": {
                                "type": "string"
                              },
                              "brand": {
                                "type": "string"
                              },
                              "category": {
                                "type": "string"
                              },
                              "size": {
                                "type": "string"
                              },
                              "price": {
                                "type": "object",
                                "properties": {
                                  "regular": {
                                    "type": "number"
                                  },
                                  "promo": {
                                    "type": "number"
                                  }
                                }
                              },
                              "aisle": {
                                "type": "string"
                              },
                              "stockLevel": {
                                "type": "string"
                              }
                            }
                          },
                          "substituted": {
                            "type": "boolean"
                          },
                          "substitutionNote": {
                            "type": [
                              "null",
                              "string"
                            ]
                          },
                          "unitPrice": {
                            "type": "number"
                          },
                          "lineTotal": {
                            "type": "number"
                          }
                        }
                      }
                    },
                    "summary": {
                      "type": "object",
                      "properties": {
                        "itemCount": {
                          "type": "integer"
                        },
                        "matchedLines": {
                          "type": "integer"
                        },
                        "unmatchedLines": {
                          "type": "integer"
                        },
                        "substitutedLines": {
                          "type": "integer"
                        },
                        "subtotal": {
                          "type": "number"
                        },
                        "estimatedTax": {
                          "type": "number"
                        },
                        "estimatedTotal": {
                          "type": "number"
                        }
                      }
                    },
                    "payment": {
                      "type": "object",
                      "properties": {
                        "success": {
                          "type": "boolean"
                        },
                        "rail": {
                          "type": "string"
                        },
                        "network": {
                          "type": "string"
                        },
                        "transaction": {
                          "type": "string"
                        },
                        "payer": {
                          "type": "string"
                        },
                        "amount": {
                          "type": "string"
                        },
                        "asset": {
                          "type": "string"
                        },
                        "resource": {
                          "type": "string"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "source": "fixture",
                  "cartId": "cart_fixture_3f2a91c4",
                  "locationId": "01400376",
                  "builtAt": "2026-08-07T12:00:00.000Z",
                  "lines": [
                    {
                      "requested": {
                        "query": "whole milk",
                        "quantity": 1
                      },
                      "matched": {
                        "productId": "0001111041700",
                        "upc": "0001111041700",
                        "description": "Kroger Vitamin D Whole Milk",
                        "brand": "Kroger",
                        "category": "Dairy",
                        "size": "1 gal",
                        "price": {
                          "regular": 3.79,
                          "promo": 3.29
                        },
                        "aisle": "Dairy",
                        "stockLevel": "HIGH"
                      },
                      "substituted": false,
                      "substitutionNote": null,
                      "unitPrice": 3.29,
                      "lineTotal": 3.29
                    }
                  ],
                  "summary": {
                    "itemCount": 3,
                    "matchedLines": 2,
                    "unmatchedLines": 0,
                    "substitutedLines": 0,
                    "subtotal": 10.27,
                    "estimatedTax": 0.67,
                    "estimatedTotal": 10.94
                  },
                  "payment": {
                    "success": true,
                    "rail": "solana",
                    "network": "solana",
                    "transaction": "5xkQ…",
                    "payer": "9wFh…",
                    "amount": "5000",
                    "asset": "EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v",
                    "resource": "http://localhost:4021/cart"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "402": {
            "$ref": "#/components/responses/PaymentRequired"
          },
          "502": {
            "$ref": "#/components/responses/UpstreamError"
          }
        },
        "x-payment-info": {
          "price": {
            "mode": "fixed",
            "currency": "USD",
            "amount": "0.005000"
          },
          "protocols": [
            {
              "x402": {}
            }
          ]
        }
      }
    },
    "/health": {
      "get": {
        "operationId": "health",
        "summary": "Liveness probe (free)",
        "description": "Free. Reports the active data source and the payment rails this instance advertises.",
        "tags": [
          "free"
        ],
        "responses": {
          "200": {
            "description": "Service status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "service": {
                      "type": "string"
                    },
                    "source": {
                      "type": "string"
                    },
                    "rails": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "rail": {
                            "type": "string"
                          },
                          "network": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/.well-known/x402": {
      "get": {
        "operationId": "manifest",
        "summary": "x402 discovery manifest (free)",
        "description": "Free. Machine-readable description of every paid resource and both payment rails.",
        "tags": [
          "free"
        ],
        "responses": {
          "200": {
            "description": "Discovery manifest",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        },
        "security": []
      }
    }
  },
  "components": {
    "schemas": {
      "PaymentRequirements": {
        "type": "object",
        "description": "One accepted way to pay, as defined by the x402 protocol.",
        "required": [
          "scheme",
          "network",
          "maxAmountRequired",
          "resource",
          "description",
          "mimeType",
          "payTo",
          "maxTimeoutSeconds",
          "asset"
        ],
        "properties": {
          "scheme": {
            "type": "string",
            "enum": [
              "exact"
            ]
          },
          "network": {
            "type": "string",
            "enum": [
              "base-sepolia",
              "base",
              "solana",
              "solana-devnet"
            ],
            "description": "The settlement network. Both an EVM and a Solana entry are always offered."
          },
          "maxAmountRequired": {
            "type": "string",
            "description": "Price in USDC atomic units (6 decimals). $0.002 → \"2000\"."
          },
          "resource": {
            "type": "string",
            "format": "uri"
          },
          "description": {
            "type": "string"
          },
          "mimeType": {
            "type": "string"
          },
          "payTo": {
            "type": "string",
            "description": "EVM address or Solana base58 address."
          },
          "maxTimeoutSeconds": {
            "type": "integer"
          },
          "asset": {
            "type": "string",
            "description": "USDC contract address (EVM) or SPL mint (Solana)."
          },
          "extra": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "PaymentRequiredResponse": {
        "type": "object",
        "required": [
          "x402Version",
          "accepts"
        ],
        "properties": {
          "x402Version": {
            "type": "integer",
            "const": 1
          },
          "error": {
            "type": "string"
          },
          "accepts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PaymentRequirements"
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "responses": {
      "PaymentRequired": {
        "description": "Payment required. The body lists both rails — pay with USDC on Base or on Solana, then retry with an `X-PAYMENT` header.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/PaymentRequiredResponse"
            },
            "example": {
              "x402Version": 1,
              "error": "X-PAYMENT header is required",
              "accepts": [
                {
                  "scheme": "exact",
                  "network": "base-sepolia",
                  "maxAmountRequired": "2000",
                  "resource": "http://localhost:4021/products",
                  "description": "Search grocery products with prices, promos, aisle locations and stock levels.",
                  "mimeType": "application/json",
                  "payTo": "0x40252CFDF8B20Ed757D61ff157719F33Ec332402",
                  "maxTimeoutSeconds": 60,
                  "asset": "0x036CbD53842c5426634e7929541eC2318f3dCF7e",
                  "extra": {
                    "name": "USDC",
                    "version": "2"
                  }
                },
                {
                  "scheme": "exact",
                  "network": "solana",
                  "maxAmountRequired": "2000",
                  "resource": "http://localhost:4021/products",
                  "description": "Search grocery products with prices, promos, aisle locations and stock levels.",
                  "mimeType": "application/json",
                  "payTo": "WwwuGbqHrwF5RG89KhUbmRWEvjnRH9k5kVM5p7T3WwW",
                  "maxTimeoutSeconds": 60,
                  "asset": "EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v",
                  "extra": {
                    "name": "USD Coin",
                    "decimals": 6,
                    "feePayer": "2wKupLR9q6wXYppw8Gr2NvWxKBUqm4PPJKkQfoxHDBg4",
                    "amount": "2000"
                  }
                }
              ]
            }
          }
        }
      },
      "BadRequest": {
        "description": "Malformed request parameters.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "UpstreamError": {
        "description": "The upstream provider failed.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  }
}
